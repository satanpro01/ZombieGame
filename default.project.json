{
  "name": "ZombieGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },

      "Client": {
        "$path": "src/client"
      },

      "Packages": {
        "$path": "./Packages"
      }
    },

    "ServerScriptService": {
      "ServerRuntime": {
        "$path": "src/serverRuntime.server.luau"
      }
    },

    "ServerStorage": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "ClientRuntime": {
          "$path": "src/clientRuntime.client.luau"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}